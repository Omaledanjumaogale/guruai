{
  "name": "Guru AI — Enterprise AI Workspace",
  "short_name": "Guru AI",
  "description": "One enterprise AI workspace for chat, studios, humanizer, keywords, transcripts, conversion, notes and agents — with E-WIN Hub identity and team governance.",
  "start_url": "/home",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#060607",
  "theme_color": "#060607",
  "categories": [
    "productivity",
    "utilities",
    "developer"
  ],
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Chat",
      "url": "/chat",
      "description": "Multi-model AI chat"
    },
    {
      "name": "Image Studio",
      "url": "/images",
      "description": "Text-to-image generation"
    },
    {
      "name": "Notes",
      "url": "/notes",
      "description": "Pinned workspace notes"
    },
    {
      "name": "E-WIN Hub",
      "url": "/hub",
      "description": "Ecosystem identity and sync"
    }
  ]
}
