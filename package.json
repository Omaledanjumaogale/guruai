{
  "name": "guru-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Guru AI — the harmonized enterprise AI workspace. Chat, generation studio, humanizer, visuals, keyword intelligence, converters, transcripts, notes, agents and a Reverse API Lab in one app.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "deploy": "npm run build && wrangler pages deploy build",
    "postinstall": "svelte-kit sync"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "svelte": "^5.25.0",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "convex": "^1.24.0"
  }
}
