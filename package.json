{
  "name": "guru-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Guru AI — the harmonized enterprise AI workspace with role-based access, private support messaging, announcements and a premium visual experience.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prebuild": "node scripts/write-build-info.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "deploy": "npm run build && wrangler pages deploy build --project-name guruai --branch main --commit-dirty true",
    "assets:generate": "node scripts/generate-artwork.mjs",
    "assets:build": "node scripts/build-assets.mjs",
    "assets:unique": "node scripts/check-asset-uniqueness.mjs",
    "assets:check": "node scripts/verify-assets.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "production:verify": "node scripts/verify-production.mjs",
    "postinstall": "svelte-kit sync"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "sharp": "^0.35.5",
    "svelte": "^5.25.0",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "convex": "^1.24.0"
  }
}
